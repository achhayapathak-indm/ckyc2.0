# Copy to .env, fill in, then:  chmod 600 .env
# .env is gitignored. Never commit it or paste its contents anywhere.

CLIENT_ID=
CLIENT_SECRET=

# Optional
# Your reporting-entity code. If blank the script falls back to CERSAI's sample reId and says so.
RE_ID=
# Host override. If blank the v2.1 testbed is used.
BASE_URL=
