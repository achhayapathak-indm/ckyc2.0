# --- secrets: never commit ---
.env
.env.*
!.env.example

# --- keys and certificates (each user supplies their own; see README) ---
certs/*
!certs/.gitkeep
*.key
*.csr
*.crt
*.cer
*.pem
*.p12
*.pfx
*.jks

# --- CERSAI-provided material: confidential, and the Postman files embed live credentials ---
*.postman_collection.json
*.postman_environment.json
*.pdf

# --- output of `search --save` contains KYC response data (personal information) ---
responses/
*.response.json

# --- local tooling ---
.venv/
__pycache__/
*.pyc
.DS_Store
